{
  "name": "@limehawk/dokploy-mcp",
  "version": "2.0.0",
  "description": "Extended MCP Server for Dokploy API with mounts, backups, and more",
  "main": "build/index.js",
  "bin": {
    "dokploy-mcp": "build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "bun run clean && tsc && chmod 755 build/index.js",
    "dev": "tsc --watch",
    "start:stdio": "node build/index.js",
    "start:http": "node build/index.js --http",
    "start:sse": "node build/index.js --sse",
    "dev:http": "bun run build && bun run start:http",
    "dev:sse": "bun run build && bun run start:sse",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.{ts,js,json}",
    "format:check": "prettier --check src/**/*.{ts,js,json}",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf build",
    "precommit": "bun run lint && bun run format:check && bun run typecheck",
    "test": "echo \"Error: no test specified\" && exit 1",
    "scrape-docs": "bun run scripts/scrape-docs.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limehawk/dokploy-mcp.git"
  },
  "keywords": [
    "modelcontextprotocol",
    "mcp",
    "dokploy"
  ],
  "author": "limehawk",
  "bugs": {
    "url": "https://github.com/limehawk/dokploy-mcp/issues"
  },
  "homepage": "https://github.com/limehawk/dokploy-mcp#readme",
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "axios": "^1.9.0",
    "express": "^5.1.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.21",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "crawlee": "^3.15.3",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "playwright": "^1.58.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  }
}
